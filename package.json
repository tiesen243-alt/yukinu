{
  "name": "yukinu",
  "private": true,
  "homepage": "https://yukinu.vercel.app",
  "bugs": {
    "url": "https://github.com/tiesen243/yukinu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/yukinu.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter './packages/*'",
    "changeset": "changeset",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "turbo dev --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.22.0"
  },
  "catalogs": {
    "prod": {
      "@tanstack/react-query": "^5.108.4",
      "nuqs": "^2.10.3",
      "recharts": "^3.11.1",
      "zod": "^4.6.7"
    },
    "dev": {
      "tsdown": "^0.23.7",
      "typescript": "^7.0.2"
    },
    "react": {
      "@types/react": "^19.3.1",
      "@types/react-dom": "^19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.5",
      "@tailwindcss/vite": "^4.3.5",
      "tailwindcss": "^4.3.5"
    },
    "uploadthing": {
      "@uploadthing/react": "^7.3.3",
      "uploadthing": "^7.7.4"
    },
    "trpc": {
      "@trpc/server": "^11.31.3",
      "@trpc/client": "^11.31.3",
      "@trpc/tanstack-react-query": "^11.31.3",
      "superjson": "^2.2.2"
    }
  }
}
